pipeline {
    agent any

    environment {
        JAR_NAME = 'Student_management_system-0.0.1-SNAPSHOT.jar'
        EC2_HOST = '13.63.49.213'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('Student_management_system') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Deploy') {
            steps {
                sshagent(['ec2-key']) {
                    sh '''
                        scp -o StrictHostKeyChecking=no Student_management_system/target/$JAR_NAME ec2-user@$EC2_HOST:/home/ec2-user/
                        ssh -o StrictHostKeyChecking=no ec2-user@$EC2_HOST "pkill -f $JAR_NAME || true; nohup java -jar /home/ec2-user/$JAR_NAME > /home/ec2-user/app.log 2>&1 &"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Build and Deployment completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check the console output.'
        }
    }
}
