pipeline {
    agent any

    environment {
        JAR_NAME = 'Student_management_system-0.0.1-SNAPSHOT.jar'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('Student_management_system') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    mkdir -p $APP_DIR
                    pkill -f $JAR_NAME || true
                    cp Student_management_system/target/$JAR_NAME $APP_DIR/
                    cd $APP_DIR
                    JENKINS_NODE_COOKIE=dontKillMe nohup java -jar $JAR_NAME > app.log 2>&1 &
                '''
            }
        }
    }

    post {
        success {
            echo 'Build and Deployment completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check the console output.'
        }
    }
}
