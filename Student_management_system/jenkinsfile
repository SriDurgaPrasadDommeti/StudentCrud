pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                dir('Student_management_system') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Test') {
            steps {
                dir('Student_management_system') {
                    sh 'mvn test'
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('Student_management_system') {
                    sh 'docker build -t student-service:latest .'
                }
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    docker stop student-service || true
                    docker rm student-service || true

                    docker run -d \
                      --name student-service \
                      --network host \
                      student-service:latest
                '''
            }
        }
    }

    post {
        success {
            echo 'Build, Test, Docker Build and Deployment completed successfully!'
        }

        failure {
            echo 'Pipeline failed. Check the console output.'
        }
    }
}
